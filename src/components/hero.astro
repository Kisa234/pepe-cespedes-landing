</section>

<style>
  @keyframes popupEntrance {
    from { opacity: 0; transform: translateY(16px) scale(0.92); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
</style>

<script>
  const discoCard = document.getElementById('disco-card') as HTMLElement | null;
  const flipper   = document.getElementById('flipper')    as HTMLElement | null;
  const cardFront = document.getElementById('card-front') as HTMLElement | null;
  const closeBtn  = document.getElementById('popup-close') as HTMLElement | null;

  cardFront?.addEventListener('click', () => {
    if (flipper) flipper.style.transform = 'rotateY(180deg)';
  });

  closeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (flipper?.style.transform === 'rotateY(180deg)') {
      flipper.style.transform = 'rotateY(0deg)';
    } else if (discoCard) {
      discoCard.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
      discoCard.style.opacity = '0';
      discoCard.style.transform = 'translateY(8px) scale(0.95)';
      setTimeout(() => discoCard.remove(), 300);
    }
  });
</script>