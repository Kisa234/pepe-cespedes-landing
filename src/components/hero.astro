---
---

<section id="hero" class="relative min-h-screen overflow-hidden bg-black">
  <div class="absolute inset-0">
    <img
      src="/images/IMG_2260.webp"
      alt="Pepe Céspedes al piano"
      fetchpriority="high"
      class="h-full w-full object-cover object-[75%_20%] sm:object-[center_20%]"
    />
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="absolute inset-0 bg-linear-to-t from-black via-black/20 to-transparent"></div>
    <div class="absolute inset-0 bg-linear-to-r from-black/70 via-transparent to-black/20"></div>
  </div>

  <div class="relative z-10 flex min-h-screen items-end md:items-center">
    <div class="mx-auto w-full max-w-7xl px-4 pb-16 pt-28 sm:px-6 sm:pb-20 lg:px-8">
      <div class="max-w-2xl">

        <!-- Popup Blues Up -->
        <div id="disco-card"
          class="fixed bottom-6 right-6 z-50 w-52 sm:w-64"
          style="animation: popupEntrance 0.6s cubic-bezier(0.34,1.56,0.64,1) 0.8s both; perspective: 1000px;">

          <button id="popup-close"
            class="absolute -top-2 -right-2 z-10 flex h-5 w-5 items-center justify-center rounded-full bg-white/20 text-white backdrop-blur-sm transition hover:bg-white/40"
            aria-label="Cerrar" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-2.5 w-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>

          <!-- Flipper -->
          <div id="flipper"
            class="grid rounded-xl shadow-2xl shadow-black/70 ring-1 ring-white/10"
            style="transform-style: preserve-3d; transition: transform 0.55s cubic-bezier(0.4,0,0.2,1);">

            <!-- FRONT -->
            <div id="card-front"
              class="col-start-1 row-start-1 cursor-pointer rounded-xl overflow-hidden bg-[#0a0a0a]"
              style="backface-visibility: hidden;">
              <img
                src="/images/discos/blues up.jpeg"
                alt="Blues Up — Pepe Céspedes & Ricardo Zárate"
                class="w-full aspect-square object-cover block"
              />
              <div class="bg-black px-3 pt-2.5 pb-3">
                <p class="text-[8px] uppercase tracking-[0.2em] text-white/40">Nuevo single · 2026</p>
                <p class="text-xs font-bold text-white mt-0.5">Blues Up</p>
                <p class="text-[8px] text-white/30 mt-1">Escuchar →</p>
              </div>
            </div>

            <!-- BACK -->
            <div id="card-back"
              class="col-start-1 row-start-1 rounded-xl overflow-hidden bg-[#0a0a0a]"
              style="backface-visibility: hidden; transform: rotateY(180deg);">

              <div class="flex items-center gap-2 px-3 py-3 bg-black border-b border-white/6">
                <img src="/images/discos/blues up.jpeg" class="w-9 h-9 rounded-md object-cover" alt="Blues Up"/>
                <div>
                  <p class="text-[8px] uppercase tracking-[0.15em] text-white/35">Nuevo single · 2026</p>
                  <p class="text-xs font-bold text-white">Blues Up</p>
                </div>
              </div>

              <div class="flex flex-col gap-2 px-3 py-3 bg-[#0a0a0a]">
                <a href="https://youtu.be/fewAFTRRL_c?si=UGnrbwcs-Qomjdmu" target="_blank" rel="noreferrer"
                  class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-[11px] font-semibold tracking-wide bg-red-500/10 text-red-400 border border-red-500/25 transition hover:bg-red-500/20 hover:translate-x-0.5">
                  <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                  YouTube
                </a>
