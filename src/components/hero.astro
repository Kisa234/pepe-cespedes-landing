                  class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-[11px] font-semibold tracking-wide bg-green-500/10 text-green-400 border border-green-500/25 transition hover:bg-green-500/20 hover:translate-x-0.5">
                  <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
                  Spotify
                </a>
                <a href="https://music.apple.com/us/album/blues-up-single/1888559350" target="_blank" rel="noreferrer"
                  class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-[11px] font-semibold tracking-wide bg-white/8 text-white/80 border border-white/14 transition hover:bg-white/14 hover:translate-x-0.5">
                  <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                  Apple Music
                </a>
                <a href="https://share.google/OCJLTDp9PZsIBtBaW" target="_blank" rel="noreferrer"
                  class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-[11px] font-semibold tracking-wide bg-violet-500/10 text-violet-400 border border-violet-500/25 transition hover:bg-violet-500/20 hover:translate-x-0.5">
                  <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M18.944 16.088H24v1.664h-5.056zM18.944 13.448H24v1.664h-5.056zM18.944 10.808H24v1.664h-5.056zM18.944 8.168H24v1.664h-5.056zM12.472 18.728H17.528v1.664H12.472zM12.472 16.088H17.528v1.664H12.472zM12.472 13.448H17.528v1.664H12.472zM6 18.728h5.056v1.664H6zM6 16.088h5.056v1.664H6zM0 18.728h4.944v1.664H0z"/></svg>
                  Deezer
                </a>
              </div>
            </div>

          </div>
        </div>

        <p class="mb-4 text-[11px] uppercase tracking-[0.3em] text-white/70 sm:text-xs">
          Pianista · Compositor
        </p>

        <h1 class="font-serif text-5xl leading-none text-white sm:text-6xl md:text-7xl lg:text-8xl">
          Pepe Céspedes
        </h1>

        <!-- Redes sociales -->
        <div class="mt-8 flex items-center gap-4">

          <a href="https://www.youtube.com/user/tioppcc" target="_blank" rel="noreferrer" aria-label="YouTube"
            class="text-white/40 transition hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
